<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:orientation="vertical"
android:background="#F5F5F5"
android:padding="24dp">

<TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Select Main Meal"
    android:textSize="24sp"
    android:textStyle="bold"
    android:textColor="#333333"
    android:layout_marginBottom="24dp" />

<RadioGroup
    android:id="@+id/rgMainMeal"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">
    <RadioButton android:id="@+id/rbBurger" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Burger" android:textSize="18sp" android:padding="12dp" android:layout_marginBottom="8dp"/>
    <RadioButton android:id="@+id/rbFriedChicken" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Fried Chicken" android:textSize="18sp" android:padding="12dp" android:layout_marginBottom="8dp"/>
    <RadioButton android:id="@+id/rbChickenNuggets" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chicken Nuggets" android:textSize="18sp" android:padding="12dp" android:layout_marginBottom="8dp"/>
</RadioGroup>

<androidx.appcompat.widget.AppCompatButton
    android:id="@+id/btnDone"
    android:layout_width="match_parent"
    android:layout_height="55dp"
    android:background="#6200EE"
    android:text="Done"
    android:textColor="#FFFFFF"
    android:textSize="18sp"
    android:textStyle="bold" />
</LinearLayout>